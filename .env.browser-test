# Browser-journey-only configuration. Committed on purpose: demo projects
# cannot contact production Firebase resources.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mizan
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_APPCHECK_SITE_KEY=demo-site-key

VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_PORT=9299
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8280
