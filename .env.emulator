# Emulator-only configuration. Committed on purpose: none of these are secrets.
#
# The `demo-` project prefix is what makes this safe — the Firebase emulator
# suite refuses to contact production for any project id starting with `demo-`,
# so a misconfigured run fails closed instead of touching mizan-the-balance.
#
# Loaded by `vite --mode emulator`, never by a production build.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mizan
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_APPCHECK_SITE_KEY=demo-site-key

# Routes auth and Firestore to the local emulators and skips App Check, which
# cannot work against a demo project. Honoured only when import.meta.env.DEV.
VITE_FIREBASE_USE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
