VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Local development only. Set to true once to print a token, register that
# token in Firebase App Check, then store the registered token here.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional local-emulator overrides. These are ignored unless
# VITE_FIREBASE_USE_EMULATORS=true in a development mode.
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
